rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =============================================
    // Habits: Users can R/W their own habits only
    // =============================================
    match /habits/{habitId} {

      // Allowed categories are strictly the 9 canonical life-area categories
      function isValidCategory(cat) {
        return cat in [
          'English Learning',
          'Movement & Strength',
          'Listening & Awareness',
          'Reading',
          'Communication',
          'Reflection',
          'Nutrition',
          'Recovery',
          'Schedule'
        ];
      }

      // CREATE: Must be authenticated, must own data, valid title & category
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && isValidCategory(request.resource.data.category);

      // UPDATE: Must own existing doc, cannot change ownership (immutable userId), valid title & category
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && isValidCategory(request.resource.data.category);

      // READ: Must own existing doc, or be non-existent check by authenticated user, or match user UID prefix
      allow read: if isAuthenticated()
                  && (resource == null || resource.data.userId == request.auth.uid || habitId.matches('^' + request.auth.uid + '_.*'));

      // DELETE: Must own the existing document
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // DailyLogs: Users can R/W their own logs only
    // =============================================
    match /dailyLogs/{logId} {

      // READ: Must be authenticated, doc must belong to user
      allow read: if isAuthenticated()
                  && (resource == null || resource.data.userId == request.auth.uid || logId.matches('^' + request.auth.uid + '_.*'));

      // CREATE: Must be authenticated, logId must start with user's UID, owned by user, valid date string
      allow create: if isAuthenticated()
                    && logId.matches('^' + request.auth.uid + '_.*')
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.date is string;

      // UPDATE: Must own existing doc, immutable ownership (userId), immutable date
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.date == resource.data.date;

      // DELETE: Must own existing doc
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // Users: Users can R/W their own profile & private progress
    // =============================================
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      // HabitState Subcollection: Decoupled cumulative routine progression
      match /habitState/{habitId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Other subcollections (e.g. private diary, audio library progress)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // =============================================
    // PersonalRoutines: Isolated storage for personalized schedules
    // Client write is disabled (managed exclusively via Admin SDK CLI)
    // =============================================
    match /personalRoutines/{routineId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Deny all other access by default
  }
}
